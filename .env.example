# AQI Predictor — Environment Variables
# Copy this to .env and fill in actual values
# .env is in .gitignore — never commit real tokens

# ─── Data Providers ──────────────────────────

# Open-Meteo (no token required, public API)
# Optional: API key for higher rate limits
OPEN_METEO_API_KEY=

# OpenAQ API (primary ground-truth source — 2+ years historical data)
OPENAQ_API_KEY=7a424d85691ee8ab1cb54aff1cc37d83e9e4ad83960954beaba81b9e67ff2d19
OPENAQ_LOCATION_ID=4889110

# AQICN API (optional secondary source — live data only)
AQICN_TOKEN=your_aqicn_token_here
AQICN_STATION=A546205

# ─── Hopsworks (Feature Store + Model Registry) ───
# Get your API key: Hopsworks UI → Account Settings → API Keys
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT=AeroTwinML
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai

# ─── MLflow (fallback when Hopsworks unavailable) ───
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=aqi_predictor
REGISTRY_BACKEND=hopsworks  # hopsworks | mlflow | local

# ─── City Config ─────────────────────────────
CITY_NAME=Hyderabad
LATITUDE=25.396
LONGITUDE=68.357
TIMEZONE=Asia/Karachi

# ─── API ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=5000

# ─── Storage ─────────────────────────────────
DATA_DIR=./data
DB_PATH=./data/aqi_predictor.db

# ─── Logging ─────────────────────────────────
LOG_LEVEL=INFO
